@startuml FixCore_Service_Planning

title FixCore - Class Diagram - Service Design & Planning

skinparam classAttributeIconSize 0

' frecuencias y estados de la programacion
enum FrequencyType {
    DAILY
    WEEKLY
    MONTHLY
    QUARTERLY
    SEMIANNUAL
    ANNUAL
}

enum ScheduleStatus {
    SCHEDULED
    RESCHEDULED
    COMPLETED
    CANCELLED
    OVERDUE
}

' clases para armar los planes
class MaintenancePlan {
    - id: UUID
    - name: String
    - description: String
    - frequency: FrequencyType
    - active: Boolean
    - createdAt: DateTime
    - updatedAt: DateTime

    + create(): void
    + update(): void
    + activate(): void
    + deactivate(): void
    + generateSchedule(): MaintenanceSchedule
}

class MaintenanceSchedule {
    - id: UUID
    - scheduledDate: DateTime
    - nextDate: DateTime
    - status: ScheduleStatus
    - createdAt: DateTime

    + schedule(date: DateTime): void
    + reschedule(newDate: DateTime): void
    + markAsDue(): void
    + markAsCompleted(): void
    + isOverdue(): Boolean
}

class MaintenancePlanner {
    - id: UUID

    + createPlan(): MaintenancePlan
    + scheduleMaintenance(plan: MaintenancePlan date: DateTime): MaintenanceSchedule
    + rescheduleMaintenance(schedule: MaintenanceSchedule date: DateTime): void
    + checkDueMaintenance(): List<MaintenanceSchedule>
}

' interfaces y consultas
interface IMaintenancePlanRepository {
    + findById(id: UUID): MaintenancePlan
    + save(plan: MaintenancePlan): void
    + update(plan: MaintenancePlan): void
}

interface IMaintenanceScheduleRepository {
    + findById(id: UUID): MaintenanceSchedule
    + findUpcoming(): List<MaintenanceSchedule>
    + findOverdue(): List<MaintenanceSchedule>
    + save(schedule: MaintenanceSchedule): void
}

interface IAssetQueryService {
    + getAsset(assetId: UUID): AssetReference
}

class AssetReference {
    + id: UUID
    + name: String
    + plantId: UUID
}

' relaciones y dependencias
MaintenancePlan "1" *-- "0..*" MaintenanceSchedule : generates

MaintenanceSchedule "0..*" --> "1" AssetReference : scheduledFor

MaintenancePlanner ..> MaintenancePlan : manages
MaintenancePlanner ..> MaintenanceSchedule : schedules

IMaintenancePlanRepository ..> MaintenancePlan : persists
IMaintenanceScheduleRepository ..> MaintenanceSchedule : persists

IAssetQueryService ..> AssetReference : returns

@enduml