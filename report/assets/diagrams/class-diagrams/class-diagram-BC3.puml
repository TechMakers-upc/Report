@startuml
title FixCore - Class Diagram - Service Design & Planning

skinparam classAttributeIconSize 0

' frecuencias y estados de la programacion
enum FrequencyTypes {
    DAILY
    WEEKLY
    MONTHLY
    QUARTERLY
    SEMIANNUAL
    ANNUAL
}

enum ScheduleStatuses {
    SCHEDULED
    RESCHEDULED
    COMPLETED
    CANCELLED
    OVERDUE
}

' clases para armar los planes
class MaintenancePlans {
    - id: UUID
    - name: String
    - description: String
    - frequency: FrequencyTypes
    - active: Boolean
    - createdAt: DateTime
    - updatedAt: DateTime

    + create(): void
    + update(): void
    + activate(): void
    + deactivate(): void
    + generateSchedule(): MaintenanceSchedules
}

class MaintenanceSchedules {
    - id: UUID
    - scheduledDate: DateTime
    - nextDate: DateTime
    - status: ScheduleStatuses
    - createdAt: DateTime

    + schedule(date: DateTime): void
    + reschedule(newDate: DateTime): void
    + markAsDue(): void
    + markAsCompleted(): void
    + isOverdue(): Boolean
}

class MaintenancePlanners {
    - id: UUID

    + createPlan(): MaintenancePlans
    + scheduleMaintenance(plan: MaintenancePlans, date: DateTime): MaintenanceSchedules
    + rescheduleMaintenance(schedule: MaintenanceSchedules, date: DateTime): void
    + checkDueMaintenance(): List<MaintenanceSchedules>
}

' interfaces y consultas
interface IMaintenancePlanRepository {
    + findById(id: UUID): MaintenancePlans
    + save(plan: MaintenancePlans): void
    + update(plan: MaintenancePlans): void
}

interface IMaintenanceScheduleRepository {
    + findById(id: UUID): MaintenanceSchedules
    + findUpcoming(): List<MaintenanceSchedules>
    + findOverdue(): List<MaintenanceSchedules>
    + save(schedule: MaintenanceSchedules): void
}

interface IAssetQueryService {
    + getAsset(assetId: UUID): AssetReferences
}

class AssetReferences {
    + id: UUID
    + name: String
    + plantId: UUID
}

' relaciones y dependencias
MaintenancePlans "1" *-- "0..*" MaintenanceSchedules : generates

MaintenanceSchedules "0..*" --> "1" AssetReferences : scheduledFor

MaintenancePlanners ..> MaintenancePlans : manages
MaintenancePlanners ..> MaintenanceSchedules : schedules

IMaintenancePlanRepository ..> MaintenancePlans : persists
IMaintenanceScheduleRepository ..> MaintenanceSchedules : persists

IAssetQueryService ..> AssetReferences : returns
@enduml