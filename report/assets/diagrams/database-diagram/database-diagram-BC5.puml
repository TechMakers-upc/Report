@startuml BD_Inventario_Repuestos

title Diagrama de Base de Datos - Inventario y Repuestos

' almacenes o bodegas registradas
entity "inventario" as inventario {
    * id : uuid <<PK>>
    --
    * planta_id : uuid
    * nombre : varchar(150)
    * ubicacion : varchar(255)
    * fecha_creacion : timestamp
}

' catalogo general de piezas
entity "repuesto" as repuesto {
    * id : uuid <<PK>>
    --
    * codigo : varchar(100) <<UK>>
    * nombre : varchar(150)
    * descripcion : varchar(500)
    * unidad : varchar(30)
    * stock_minimo : decimal(10.2)
    * activo : boolean
    * fecha_creacion : timestamp
}

' cantidades disponibles en cada almacen
entity "stock" as stock {
    * id : uuid <<PK>>
    --
    * inventario_id : uuid <<FK>>
    * repuesto_id : uuid <<FK>>
    * cantidad : decimal(10.2)
    * cantidad_reservada : decimal(10.2)
    * estado : varchar(30)
    * fecha_actualizacion : timestamp
}

' historial de entradas salidas y traslados
entity "movimiento_inventario" as movimiento {
    * id : uuid <<PK>>
    --
    * inventario_id : uuid <<FK>>
    * repuesto_id : uuid <<FK>>
    * tipo_movimiento : varchar(30)
    * cantidad : decimal(10.2)
    * referencia_id : uuid
    * descripcion : varchar(500)
    * fecha_creacion : timestamp
}

' avisos automaticos de stock bajo
entity "alerta_inventario" as alerta {
    * id : uuid <<PK>>
    --
    * stock_id : uuid <<FK>>
    * tipo_alerta : varchar(50)
    * mensaje : varchar(500)
    * estado : varchar(30)
    * fecha_creacion : timestamp
    * fecha_resolucion : timestamp
}

' control de existencias
inventario ||--o{ stock : contiene
repuesto ||--o{ stock : tiene

' registro de transacciones
inventario ||--o{ movimiento : registra
repuesto ||--o{ movimiento : participa

' alertas generadas por niveles de stock
stock ||--o{ alerta : genera

@enduml